{
  "manifest_version": 3,
  "name": "Fudan SafeTest",
  "version": "2026.8.34",
  "description": "按真实计时自动完成安全课程阅读，并为安全考试选择题库答案；永不自动提交试卷。",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "http://lsem.fudan.edu.cn/*",
    "https://lsem.fudan.edu.cn/*"
  ],
  "action": {
    "default_title": "Fudan SafeTest",
    "default_popup": "extension/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://lsem.fudan.edu.cn/*",
        "https://lsem.fudan.edu.cn/*"
      ],
      "js": ["extension/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["asset/questions.json"],
      "matches": [
        "http://lsem.fudan.edu.cn/*",
        "https://lsem.fudan.edu.cn/*"
      ]
    }
  ]
}
